{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/t0mer/kamino/schema/category.schema.json",
  "title": "Kamino category file",
  "type": "object",
  "required": ["id", "name", "items"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "order": { "type": "integer" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "source": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "amd64": { "type": "string" },
            "arm64": { "type": "string" }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "required": ["id", "name", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["apt", "deb", "tarball", "binary", "pip", "script", "compose_stack", "snap"]
        },
        "version": { "type": "string" },
        "source": { "$ref": "#/$defs/source" },
        "sha256": { "$ref": "#/$defs/source" },
        "packages": { "type": "array", "items": { "type": "string" } },
        "repo": { "type": "string" },
        "python": { "type": "string" },
        "install_dir": { "type": "string" },
        "path_export": { "type": "string" },
        "path": { "type": "string", "description": "Directory inside the config repo holding a compose stack's files (compose_stack)." },
        "files": { "type": "array", "items": { "type": "string" }, "description": "Files fetched from `path` and materialised before `docker compose up -d`. Must include a docker-compose file." },
        "env_file": { "type": "string", "description": "Marker that a compose_stack consumes secret env vars; values come from `secrets`, injected as process env, never written to disk." },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" }
        },
        "check": { "type": "string" },
        "check_contains": { "type": "string" },
        "pre_install": { "type": "array", "items": { "type": "string" } },
        "post_install": { "type": "array", "items": { "type": "string" } },
        "timeout": { "type": "string", "pattern": "^[0-9]+[smh]$" },
        "arch": {
          "type": "array",
          "items": { "type": "string", "enum": ["amd64", "arm64"] }
        },
        "secrets": { "type": "array", "items": { "type": "string" }, "description": "Names of secret values the UI/CLI must supply at run time; never stored in the config repo." }
      }
    }
  }
}
